# Redis
REDIS_URL=redis://localhost:6379

# App
BASE_URL=http://localhost:3000
PORT=3000

# CORS — set to your static site URL in production
ALLOWED_ORIGIN=http://localhost:5173


# Rate limits (requests per window — override to tune per environment)
RATE_LIMIT_REGISTER=5    # per IP per hour
RATE_LIMIT_LOGIN=10      # per IP per 15 minutes
RATE_LIMIT_REDIRECT=60   # per IP per minute

ENV=development